APP_NAME=Bada API
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000

# Use SQLite for local-only development without Docker:
# DATABASE_URL=sqlite:///./bada.db
DATABASE_URL=postgresql+psycopg2://bada:bada_dev_password@localhost:5432/bada

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
USE_CELERY=false

SECRET_KEY=change-me-in-production-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
ALGORITHM=HS256

S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=bada_minio
S3_SECRET_KEY=bada_minio_secret
S3_BUCKET=bada-media
S3_REGION=us-east-1
S3_USE_SSL=false
LOCAL_MEDIA_DIR=./media

# Gemini: org may disallow API keys — prefer ADC (Vertex AI)
# Cloud Run: leave GEMINI_API_KEY empty; set GEMINI_USE_ADC=true + project
# Local ADC: gcloud auth application-default login
GEMINI_API_KEY=
GEMINI_USE_ADC=false
GEMINI_MODEL=gemini-2.0-flash
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@bada.ai

FRONTEND_URL=http://localhost:3000
MEDIA_MARGIN_PERCENT=20
MINIMUM_DAILY_BUDGET=1000
DEFAULT_CPM=250
SEED_DEMO_DATA=true
